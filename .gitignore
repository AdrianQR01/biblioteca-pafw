# =============================================================================
# .gitignore — Proyecto Biblioteca (PAFW Fase 3: Despliegue Git + GitHub + Render)
# Requisito R3: exclusión estricta de node_modules, .env, bases de datos y artefactos
# =============================================================================

# Dependencias (nunca versionar)
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno y secretos reales (R3, R15)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Base de datos SQLite y diarios de transacciones (R3, R10, R19)
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
prisma/dev.db
backend/dev.db
backend/prisma/dev.db

# Artefactos de compilación de Frontend (R3, R13)
dist/
dist-ssr/
frontend/dist/
build/
*.local

# Archivos del sistema operativo y editores
.DS_Store
*/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Cobertura y testing
coverage/
*/coverage/
