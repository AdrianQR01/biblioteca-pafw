{
  "name": "biblioteca-backend",
  "version": "1.0.0",
  "description": "API REST para gestión de catálogo bibliográfico con Express, Prisma y SQLite",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node src/seed.js",
    "db:seed:force": "node src/seed.js --force",
    "setup": "prisma generate && prisma db push && node src/seed.js",
    "render:build": "prisma generate && prisma db push && node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "keywords": [
    "express",
    "prisma",
    "sqlite",
    "render",
    "pafw"
  ],
  "author": "Adrián Quenard (Adrian QR)",
  "license": "ISC"
}
