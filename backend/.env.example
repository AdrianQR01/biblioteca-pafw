# =============================================================================
# BACKEND - VARIABLES DE ENTORNO (.env.example)
# Proyecto Biblioteca - PAFW Fase 3 (Express + Prisma + SQLite)
# =============================================================================
# IMPORTANTE: Copia este archivo como .env para desarrollo local.
# En producción (Render Web Service), define estas variables en el panel
# "Environment" del servicio sin incluir comillas ni secretos reales en git.

# Puerto de escucha del servidor (R6)
# En local se usa 3000. En Render, la plataforma inyecta PORT automáticamente (ej. 10000).
PORT=3000

# Entorno de ejecución: 'development' o 'production' (R8, R11)
# En 'production', el manejador de errores NO expone stack traces y CORS es estricto.
NODE_ENV=development

# Cadena de conexión para Prisma ORM (R7, R10)
# Para SQLite en local y Render Free: "file:./dev.db" o "file:./prisma/dev.db"
DATABASE_URL="file:./dev.db"

# Clave secreta para operaciones protegidas POST, PATCH y DELETE (R7, R15)
# En local usa un valor de prueba. En Render usa una clave aleatoria y segura.
API_KEY=pon-aqui-tu-clave-de-desarrollo

# URL pública del Frontend autorizada en CORS (R7, R8)
# En desarrollo: "http://localhost:5173"
# En producción en Render: "https://biblioteca-frontend-adrian.onrender.com"
# ¡ATENCIÓN! No incluyas barra final al configurar la URL de producción.
FRONTEND_URL=http://localhost:5173
